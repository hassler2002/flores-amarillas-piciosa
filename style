body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
    background: radial-gradient(circle at top, #0a0a0a, #000000);
    color: #fff;
    text-align: center;
    min-height: 100vh; /* ✅ usa min-height en lugar de height */
    overflow-x: hidden; /* evita scroll lateral */
}


/* Estrellas */
body::before {
    content: "";
    position: fixed; /* ✅ cambia a fixed para que cubra todo */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent url("https://www.transparenttextures.com/patterns/stardust.png") repeat;
    opacity: 0.3;
    z-index: -1;
}


h1 {
    margin-top: 80px;
    font-size: 2.8em;
    color: #ffd700;
    text-shadow: 0 0 15px #ffd700;
}

.mensaje {
    font-size: 1.5em;
    margin: 20px 0;
    animation: fadeIn 3s ease-in-out infinite alternate;
}

button {
    padding: 15px 30px;
    font-size: 1.3em;
    border: none;
    border-radius: 15px;
    background: #ffd700;
    color: #000;
    cursor: pointer;
    animation: pulse 1.5s infinite;
}

@keyframes fadeIn {
    from { opacity: 0.5; }
    to { opacity: 1; }
}

@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); background: #ffea00; }
    100% { transform: scale(1); }
}

.flower, .heart {
    position: absolute;
    font-size: 2em;
    animation: fall 5s linear infinite;
}

@keyframes fall {
    0% { transform: translateY(-50px) rotate(0deg); opacity: 1; }
    100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
}

.gallery {
    margin-top: 30px;
}

.gallery img {
    width: 200px;
    border-radius: 15px;
    margin: 10px;
    box-shadow: 0 0 10px #ffd700;
}

/* Carta animada */
.carta {
    margin-top: 30px;
    font-size: 1.3em;
    color: #ffd700;
    white-space: pre-line;
}

